+// SOURCE-ONLY candidate: output interpretation, not a triangulation change.
+// Single owned CPU allocation; original GDelOutput raw rows are retained.
+static torch::Tensor exportTetRows(const GDelOutput& output, bool finalAliveOnly) {
+    static_assert(sizeof(int) == sizeof(int32_t), "Native Tet int must be int32");
+    const int64_t rawCount = static_cast<int64_t>(output.tetVec.size());
+    int64_t keepCount = rawCount;
+    if (finalAliveOnly) {
+        TORCH_CHECK(output.tetInfoVec.size() == output.tetVec.size(),
+                    "Final tetInfoVec/tetVec row alignment mismatch");
+        keepCount = 0;
+        for (int64_t row = 0; row < rawCount; ++row) {
+            if (isTetAlive(output.tetInfoVec[row])) ++keepCount;
+        }
+    }
+    torch::Tensor rows = torch::empty({keepCount, 4},
+        torch::TensorOptions().dtype(torch::kInt32).device(torch::kCPU));
+    int32_t* destination = rows.data_ptr<int32_t>();
+    int64_t written = 0;
+    for (int64_t row = 0; row < rawCount; ++row) {
+        if (!finalAliveOnly || isTetAlive(output.tetInfoVec[row])) {
+            std::memcpy(destination + 4 * written, output.tetVec[row]._v,
+                        4 * sizeof(int32_t));
+            ++written;
+        }
+    }
+    TORCH_CHECK(written == keepCount, "Final tet export count changed");
+    return rows;
+}
+
 class PyGDelOutput {
     public:
         GDelOutput   output; 
+        torch::Tensor getTetInfo() const;
+        torch::Tensor getRawTets() const;
         bool checkCorrectness(torch::Tensor &points);
         torch::Tensor computePointImportance(torch::Tensor &points);
         torch::Tensor getBoundaryTets(torch::Tensor &points);
 };
+// Read-only diagnostic rows remain the original complete native output.
+torch::Tensor PyGDelOutput::getRawTets() const {
+    return exportTetRows(output, false);
+}
+
+// Diagnostic-only owned CPU copy; aligned with get_raw_tets(), not filtered return.
+torch::Tensor PyGDelOutput::getTetInfo() const {
+    const auto count = static_cast<int64_t>(output.tetInfoVec.size());
+    TORCH_CHECK(count == static_cast<int64_t>(output.tetVec.size()),
+                "tetInfoVec/tetVec row alignment mismatch");
+    torch::Tensor info = torch::empty({count},
+        torch::TensorOptions().dtype(torch::kUInt8).device(torch::kCPU));
+    if (count > 0) {
+        std::memcpy(info.data_ptr<uint8_t>(), output.tetInfoVec.data(),
+                    static_cast<std::size_t>(count) * sizeof(char));
+    }
+    return info;
+}
